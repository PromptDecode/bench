{
  "schema_version": 1,
  "interpretation": "This detector separates the claimed corpus completely, and that is the only scope the CI gate reads: `operating_points` covers just the families the benchmark claims, and there recall is 1.0 with zero false positives. The unclaimed families beside them document the rest of the picture. The detector misses whole classes of attacks that carry no Unicode-class signal - instructions hidden in HTML comments, markdown link titles, and CSS-invisible spans, base64 and rot13 payloads, homoglyph instructions whose every letter is substituted, and zero-width steganography placed only at word boundaries - and it raises false positives on legitimate CJK ideographic variation sequences. `full_corpus_operating_points` reports the unrestricted result over every family, and there recall falls well short of 1.0 at the strict false-positive targets. All of this remains a fact about a corpus and a detector written in the same repository, not evidence that the detector generalises.",
  "corpus": {
    "name": "promptdecode-bench",
    "digest": "sha256:c0d8fd7b4f6925333e7c1764c787a2578fd1f07574442a309a9863dc5fbb18c8",
    "cases": {
      "total": 270,
      "attack": 118,
      "benign": 152
    },
    "families": [
      {
        "family": "bidi-override-trojan",
        "label": "attack",
        "claimed": true,
        "description": "Trojan-Source-style attacks built from the bidi controls U+202A to U+202E and the isolates U+2066 to U+2069, where the rendered order of the text differs from its logical order. Every case uses unbalanced or unterminated embeddings, overrides, or isolates, and every override targets text with no right-to-left letters at all, which no legitimate use of these controls does.",
        "cases": 8
      },
      {
        "family": "business-correspondence",
        "label": "benign",
        "claimed": true,
        "description": "Ordinary professional correspondence carrying the incidental non-ASCII that real business writing contains: accented names, currency signs, © ™ ®, degree signs, signature blocks, a quoted-reply thread, an invoice, a calendar invite, and a legal notice. Nothing is hidden; every character is visible and in its normal place.",
        "cases": 12
      },
      {
        "family": "cjk-variation-selectors",
        "label": "benign",
        "claimed": false,
        "description": "Japanese and Chinese text using legitimate ideographic variation sequences (a CJK ideograph immediately followed by a variation selector from the Ideographic Variation Database), the standard way to select a registered glyph variant in personal and place names. The detector scores these as anomalous selectors and flags every case.",
        "cases": 7
      },
      {
        "family": "confusable-alphabet-obfuscation",
        "label": "attack",
        "claimed": true,
        "description": "Instructions rewritten in alphabets a human can still decode at a glance but a keyword filter cannot match: mathematical alphanumeric symbols, fullwidth forms, enclosed alphanumerics, and Cherokee/Deseret lookalikes standing in for Latin capitals.",
        "cases": 8
      },
      {
        "family": "directional-mark-injection",
        "label": "attack",
        "claimed": true,
        "description": "Left-to-right marks U+200E, right-to-left marks U+200F and Arabic letter marks U+061C injected into text that contains no right-to-left letters at all, so the marks serve no typographic purpose. Covers single-mark chaff and dense runs that encode data bit by bit.",
        "cases": 8
      },
      {
        "family": "emoji-sequences",
        "label": "benign",
        "claimed": true,
        "description": "Legitimate emoji that exercise the same invisible machinery attackers reuse: ZWJ joins, variation selectors, keycaps, skin-tone modifiers, regional indicators, and a complete tag-sequence subdivision flag. These are the sharpest hard negatives in the corpus — a detector that flags any of these mechanisms will false-positive on everyday emoji.",
        "cases": 12
      },
      {
        "family": "emoji-zwj-commit-messages",
        "label": "benign",
        "claimed": false,
        "description": "Realistic git commit messages whose subjects and bodies contain emoji ZWJ sequences. The joiners sit between emoji codepoints, never between two Latin letters, and never form a run of three, so every case is expected to be a true negative while exercising the same invisible machinery attackers reuse.",
        "cases": 7
      },
      {
        "family": "encoded-instructions-plain-sight",
        "label": "attack",
        "claimed": false,
        "description": "Instructions presented as opaque text for the model to decode and act on: base64, rot13, and a base64-of-rot13 layer, framed as a routine request. The carrier text is pure ASCII, so no Unicode character-class signal fires.",
        "cases": 6
      },
      {
        "family": "homoglyph-only-instructions",
        "label": "attack",
        "claimed": false,
        "description": "Instructions in which EVERY letter of each four-or-more-letter word is swapped for a look-alike from Cyrillic, Greek, Armenian, Cherokee, or Coptic. Full-word substitution leaves no Latin residue, so the minority-substitution shape the mixed-script-word signal looks for never appears.",
        "cases": 8
      },
      {
        "family": "homoglyph-substitution",
        "label": "attack",
        "claimed": true,
        "description": "Latin text with individual letters swapped for visually identical characters from other scripts (Cyrillic, Greek, Cherokee, Deseret, fullwidth forms). What separates these from legitimate multilingual prose is script mixing inside a single word, which spoofs brands, keywords and identifiers.",
        "cases": 8
      },
      {
        "family": "html-comment-injection",
        "label": "attack",
        "claimed": false,
        "description": "Instruction payloads hidden inside HTML comments in otherwise plain text, markdown, or log excerpts. The comment renders as nothing and contains no Unicode character-class signal, so a detector that only reads codepoints sees pure ASCII.",
        "cases": 6
      },
      {
        "family": "invisible-css-rendered-markdown",
        "label": "attack",
        "claimed": false,
        "description": "Instruction payloads made invisible by presentation rather than by codepoint: display:none, zero font-size, background-matching colour, visibility:hidden, off-screen positioning, and aria-hidden, embedded in markdown or HTML. All ASCII, so no Unicode-class signal fires.",
        "cases": 6
      },
      {
        "family": "invisible-format-chars",
        "label": "attack",
        "claimed": true,
        "description": "Format and filler characters outside the zero-width and bidi families: soft hyphen U+00AD, Mongolian vowel separator U+180E, Hangul fillers U+115F, U+1160, U+3164 and U+FFA0, and the invisible operators U+2061-U+2064. Covers keyword-splitting evasion via splits inside short words, where genuine hyphenation never occurs, and filler runs that carry or pad hidden payloads.",
        "cases": 8
      },
      {
        "family": "joiners-in-native-scripts",
        "label": "benign",
        "claimed": true,
        "description": "Legitimate U+200C ZWNJ and U+200D ZWJ inside words whose orthography requires them: Persian half-spaces and the plural suffix, Devanagari half-form and eyelash-ra control, Bengali ya-phala, Tamil, Malayalam chillu, Sinhala, Kannada, and Arabic joining. These are the canonical false positives for any detector that flags zero-width characters outright; every joiner sits between two letters of one non-Latin script.",
        "cases": 12
      },
      {
        "family": "layered-smuggling",
        "label": "attack",
        "claimed": true,
        "description": "Adversarial texts that combine two or more smuggling classes in one message, the way real attacks stack. Each rationale names every class the case combines; these are the corpus's hardest recall cases.",
        "cases": 8
      },
      {
        "family": "markdown-link-title-payload",
        "label": "attack",
        "claimed": false,
        "description": "Instruction payloads hidden in a markdown link's title string, which renders only as a tooltip and is routinely ignored by readers. The text is plain ASCII, so no Unicode character-class signal fires.",
        "cases": 6
      },
      {
        "family": "math-and-science",
        "label": "benign",
        "claimed": true,
        "description": "Scientific and mathematical text where format characters carry their actual meaning: Greek letters in formulae, mathematical operators, the invisible operators U+2061 and U+2062 exactly as MathML-derived text produces them, superscripts and subscripts, chemical formulae, units, abstracts, and a statistics table. The attack corpus uses these operators as padding; here each one separates a function from its argument or marks a product.",
        "cases": 12
      },
      {
        "family": "multilingual-prose",
        "label": "benign",
        "claimed": true,
        "description": "Ordinary everyday prose written in non-Latin scripts and mixed-script combinations that occur naturally, from Japanese reviews to Arabic news leads. These cases stop a detector from treating visible non-Latin text as suspicious.",
        "cases": 12
      },
      {
        "family": "plain-prose",
        "label": "benign",
        "claimed": true,
        "description": "Ordinary plain-ASCII English prose of the kind people send to assistants every day, with no hidden characters and nothing unusual about its encoding. This family anchors the false-positive side of the benchmark.",
        "cases": 12
      },
      {
        "family": "private-use-area",
        "label": "attack",
        "claimed": true,
        "description": "Payloads and hidden instruction blocks built from private-use codepoints (U+E000-U+F8FF, plane 15 U+F0000-U+FFFFD and plane 16 U+100000-U+10FFFD), which no font resolves and many renderers strip. Covers byte-per-codepoint payloads on all three planes and PUA delimiters wrapped around an injected instruction block.",
        "cases": 8
      },
      {
        "family": "prompts-about-instructions",
        "label": "benign",
        "claimed": true,
        "description": "Legitimate plain-ASCII text that discusses prompt injection and instruction override in the abstract: incident writeups, detector documentation, red-team plans, policy pages, and questions that quote override phrasings. A detector that keyword-matches override vocabulary will flag these; one that reads context will not. That distinction is what this family measures.",
        "cases": 12
      },
      {
        "family": "rtl-legitimate-bidi-marks",
        "label": "benign",
        "claimed": false,
        "description": "Arabic and Hebrew sentences that use the LEFT-TO-RIGHT MARK (U+200E) to keep an embedded Latin term, acronym, filename, or bracketed phrase reading in the right direction. This is the mirror image of the directional marks in rtl-with-bidi-controls and a real, common practice in mixed-direction text.",
        "cases": 6
      },
      {
        "family": "rtl-with-bidi-controls",
        "label": "benign",
        "claimed": true,
        "description": "Text that legitimately mixes right-to-left and left-to-right content and therefore uses Unicode bidi controls correctly: every isolate and embedding is balanced and terminated, and every control is applied to text that really contains RTL letters. These are the benign counterparts of unbalanced bidi splicing attacks.",
        "cases": 12
      },
      {
        "family": "source-code",
        "label": "benign",
        "claimed": true,
        "description": "Real-looking source code in several languages, including security tooling whose text spells out invisible and bidi codepoints as escape sequences without containing the characters themselves. A detector that treats escape spellings, codepoint names, or security vocabulary as evidence of smuggling will false-positive here.",
        "cases": 12
      },
      {
        "family": "structured-data",
        "label": "benign",
        "claimed": true,
        "description": "Machine-shaped text a detector must not flag: JSON payloads, YAML configuration, CSV extracts, log lines, HTTP headers, a diff, and an SPDX SBOM. None of it is addressed to a model and none of it hides anything; its density of punctuation and identifiers is normal for the formats.",
        "cases": 12
      },
      {
        "family": "typography",
        "label": "benign",
        "claimed": true,
        "description": "Professional typesetting that uses format characters for their intended purpose: soft hyphens at genuine syllable breaks in long words, word joiners preventing breaks, no-break and thin spaces, curly quotes, dashes, ellipsis, and a leading byte order mark on exported files. The attack corpus reuses these codepoints to split short keywords; the length, position, and context here are what make each use legitimate.",
        "cases": 12
      },
      {
        "family": "unicode-tag-block",
        "label": "attack",
        "claimed": true,
        "description": "Instructions hidden in the Unicode tag block (U+E0000 to U+E007F), which renders as nothing in most editors, terminals, and browsers. This family measures whether the detector catches smuggling that a human reviewer cannot see.",
        "cases": 8
      },
      {
        "family": "variation-selector-smuggling",
        "label": "attack",
        "claimed": true,
        "description": "Payloads carried in variation selectors (U+FE00-U+FE0F and the supplement U+E0100-U+E01EF), which render as nothing. Covers long selector runs that encode byte payloads after an ordinary character, and selectors attached to characters that have no legitimate variant form.",
        "cases": 8
      },
      {
        "family": "zero-width-bit-encoding",
        "label": "attack",
        "claimed": false,
        "description": "A steganographic channel that encodes bits as zero-width characters placed only at word or punctuation boundaries, never between two letters and never as a run of three or more. The presence, absence, and identity of the characters carry the payload while the boundary placement keeps both the in-word and the run signal silent.",
        "cases": 6
      },
      {
        "family": "zero-width-smuggling",
        "label": "attack",
        "claimed": true,
        "description": "Payloads carried by zero-width characters: binary encodings over ZWSP, ZWNJ, ZWJ, FEFF and word joiner that render as nothing, and zero-width characters inserted inside Latin words so that keyword matching sees fragmented instructions. Measures recall against smuggling that is invisible both to the eye and to naive string filters.",
        "cases": 8
      }
    ],
